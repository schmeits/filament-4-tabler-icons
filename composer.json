{
    "name": "schmeits/filament-4-tabler-icons",
    "description": "Tabler icons as a typed enum for Filament 4 and 5, built on blade-tabler-icons.",
    "keywords": [
        "schmeits",
        "laravel",
        "filament",
        "filament-plugin",
        "icons",
        "tabler",
        "tabler-icons",
        "blade-icons"
    ],
    "homepage": "https://github.com/schmeits/filament-4-tabler-icons",
    "support": {
        "issues": "https://github.com/schmeits/filament-4-tabler-icons/issues",
        "source": "https://github.com/schmeits/filament-4-tabler-icons"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Tally Schmeits",
            "email": "tally@schmeits.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "secondnetwork/blade-tabler-icons": "^3.49",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.2|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Schmeits\\FilamentTablerIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schmeits\\FilamentTablerIcons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "generate": "@php bin/generate-enum.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schmeits\\FilamentTablerIcons\\FilamentTablerIconsServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
